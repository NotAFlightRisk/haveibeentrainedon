{
  "name": "haveibeentrainedon",
  "version": "0.1.0",
  "description": "Check whether your writing is in the open AI training sets, by searching for your own sentences",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NotAFlightRisk/haveibeentrainedon.git"
  },
  "homepage": "https://haveibeentrainedon.peng.ly",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite build && wrangler dev src/worker.ts",
    "build": "vite build && wrangler deploy src/worker.ts --dry-run --outdir .wrangler/dist",
    "deploy": "vite build && wrangler deploy src/worker.ts",
    "migrate": "wrangler d1 migrations apply DB",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "devDependencies": {
    "@fontsource-variable/libre-franklin": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@sentry/browser": "^11.16.0",
    "@sentry/vite-plugin": "^11.16.0",
    "@sveltejs/adapter-cloudflare": "^8.0.3",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  },
  "dependencies": {
    "htmlparser2": "^12.0.0"
  }
}
